rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function professor() {
      return request.auth != null && request.auth.uid == '3Rl7hf3QbwPfmdSWgZcbqg7J2Rj2';
    }
    function aluno() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    match /assessments/{assessmentId} {
      // O aluno autenticado pode visualizar apenas a revisão selecionada pelo link.
      // Em uma revisão pública, o JSON do gabarito está acessível: NÃO usar como prova oficial.
      allow get: if request.auth != null;
      allow list: if professor();
      allow create, update, delete: if professor();
      match /attempts/{uid} {
        allow get: if professor() || (request.auth != null && request.auth.uid == uid);
        allow list: if professor();
        allow create: if aluno() && request.auth.uid == uid
          && get(/databases/$(database)/documents/assessments/$(assessmentId)).data.open == true
          && request.resource.data.keys().hasOnly(['uid','session','name','registration','className','updated','answers','done','total'])
          && request.resource.data.uid == uid
          && request.resource.data.session == get(/databases/$(database)/documents/assessments/$(assessmentId)).data.session
          && request.resource.data.done == false
          && request.resource.data.answers is list && request.resource.data.answers.size() == 20
          && request.resource.data.total == 20
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
          && request.resource.data.registration is string && request.resource.data.registration.size() > 0 && request.resource.data.registration.size() <= 40
          && request.resource.data.className is string && request.resource.data.className.size() > 0 && request.resource.data.className.size() <= 60
          && request.resource.data.updated is number;
        allow update: if aluno() && request.auth.uid == uid
          && resource.data.uid == uid && resource.data.done == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updated','answers','done'])
          && request.resource.data.session == resource.data.session
          && request.resource.data.answers is list && request.resource.data.answers.size() == 20
          && request.resource.data.updated is number
          && request.resource.data.done is bool;
        allow delete: if professor();
      }
    }

    // Compatibilidade com o quiz antigo (av2frontend).
    match /quiz/settings {
      allow read: if request.auth != null;
      allow write: if professor();
    }
    match /attempts/{uid} {
      allow read: if professor() || (request.auth != null && request.auth.uid == uid);
      allow create: if aluno() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id','session','name','registration','className','answers','total','done','updated'])
        && request.resource.data.id == uid
        && request.resource.data.done == false
        && request.resource.data.answers is list
        && request.resource.data.total is int
        && request.resource.data.total >= 1
        && request.resource.data.total <= 100
        && request.resource.data.answers.size() == request.resource.data.total
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.registration is string && request.resource.data.registration.size() <= 40
        && request.resource.data.className is string && request.resource.data.className.size() <= 40;
      allow update: if aluno() && request.auth.uid == uid
        && resource.data.id == request.resource.data.id
        && resource.data.session == request.resource.data.session
        && resource.data.name == request.resource.data.name
        && resource.data.registration == request.resource.data.registration
        && resource.data.className == request.resource.data.className
        && resource.data.total == request.resource.data.total
        && resource.data.done == false
        && request.resource.data.keys().hasOnly(['id','session','name','registration','className','answers','total','done','updated'])
        && request.resource.data.answers is list
        && request.resource.data.answers.size() == resource.data.total
        && request.resource.data.updated is number;
      allow delete: if professor();
    }
  }
}
